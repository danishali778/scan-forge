ENVIRONMENT=local
ENABLE_DOCS=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws/v1

# Backend
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=app_session
CSRF_COOKIE_NAME=app_csrf
CSRF_HEADER_NAME=X-CSRF-Token
AUTH_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=28800
REFRESH_SESSION_TTL_SECONDS=2592000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Hosted Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+psycopg://postgres:password@db.project-ref.supabase.co:5432/postgres

# Optional smoke test credentials. The user should already exist in Supabase Auth.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Queue and worker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
JOB_STALE_SECONDS=900
AGENT_MAX_TURNS_PER_JOB=3

# Evidence and reporting
ARTIFACT_STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=pentagi-artifacts
EVIDENCE_INLINE_MAX_BYTES=32768
REPORT_EXPORT_STORAGE_PREFIX=reports

# Memory and knowledge
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_CHUNK_MAX_CHARS=2000
MEMORY_CHUNK_OVERLAP_CHARS=200
MEMORY_SEARCH_DEFAULT_LIMIT=5
MEMORY_SEARCH_MAX_LIMIT=20

# Session replay and analytics
REPLAY_MAX_EVENTS=5000
REPLAY_PAYLOAD_MAX_BYTES=32768
ANALYTICS_DEFAULT_WINDOW_DAYS=30
ANALYTICS_MAX_WINDOW_DAYS=365

# Runtime service
RUNTIME_SERVICE_URL=http://runtime:8001
RUNTIME_WORKSPACE_ROOT=/var/lib/pentagi-runtime
RUNTIME_DEFAULT_IMAGE=pentagi-runtime-python:local
RUNTIME_CONTAINER_LABEL_PREFIX=pentagi
RUNTIME_DEFAULT_TIMEOUT_SECONDS=300
RUNTIME_MAX_OUTPUT_BYTES=1048576
RUNTIME_FILE_READ_MAX_BYTES=1048576
RUNTIME_FILE_WRITE_MAX_BYTES=1048576
RUNTIME_NETWORK_MODE=none
RUNTIME_ALLOWED_COMMANDS=python,python3,pwd,ls,cat,echo,find
